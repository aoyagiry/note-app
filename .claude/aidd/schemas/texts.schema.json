{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.local/schemas/texts",
  "type": "object",
  "properties": {
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$"
          },
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "screen",
          "where",
          "text"
        ]
      }
    }
  },
  "required": [
    "texts"
  ]
}
