{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.local/schemas/shared-rules",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^RULE-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^AC-[a-z][a-z0-9]*(?:-[a-z0-9]+)*-\\d+$"
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "then"
              ]
            }
          }
        },
        "required": [
          "id",
          "statement"
        ]
      }
    }
  },
  "required": [
    "rules"
  ]
}
