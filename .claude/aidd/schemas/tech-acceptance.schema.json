{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.local/schemas/tech-acceptance",
  "type": "object",
  "properties": {
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^AC-[a-z][a-z0-9]*(?:-[a-z0-9]+)*-\\d+$"
          },
          "aspect": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "checked_by": {
            "enum": [
              "test",
              "ci",
              "human"
            ]
          }
        },
        "required": [
          "id",
          "then",
          "checked_by"
        ]
      }
    }
  },
  "required": [
    "acceptance"
  ]
}
