{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.local/schemas/toolchain",
  "type": "object",
  "properties": {
    "setup": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "files",
        "command"
      ]
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "measurement": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "nfr_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "start": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\{at\\}"
        },
        "login": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "command",
        "url"
      ],
      "additionalProperties": false
    },
    "test_reports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "visual_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "commands",
    "test_reports"
  ]
}
