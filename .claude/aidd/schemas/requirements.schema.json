{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.local/schemas/requirements",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^REQ-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^AC-[a-z][a-z0-9]*(?:-[a-z0-9]+)*-\\d+$"
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "then"
              ]
            }
          }
        },
        "required": [
          "id",
          "statement"
        ]
      }
    },
    "nfr": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^NFR-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "enum": [
              "test",
              "tool",
              "measurement",
              "human"
            ]
          },
          "after_release": {
            "type": "boolean"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "statement",
          "check"
        ]
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^SCR-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    }
  },
  "required": [
    "purpose",
    "requirements"
  ]
}
