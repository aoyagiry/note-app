{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidd.local/schemas/shared-terms",
  "type": "object",
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^TERM-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "definition"
        ]
      }
    }
  },
  "required": [
    "terms"
  ]
}
